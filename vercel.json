{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/order",
      "destination": "/order.html"
    }
  ],
  "redirects": [
    {
      "source": "/go/2",
      "destination": "https://tryglpro.com/f/szs6tw?aff_id=332510",
      "permanent": false
    },
    {
      "source": "/go/3",
      "destination": "https://tryglpro.com/f/szs6tw?aff_id=332510",
      "permanent": false
    },
    {
      "source": "/go/6",
      "destination": "https://tryglpro.com/f/szs6tw?aff_id=332510",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/key.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/go/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/order",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}